  "_croquis": [
    "Proxy ASCII de un carácter por grafema. Es la ÚNICA vista que el modelo tiene de",
    "una composición, y por eso importa tanto: en ASCII puro sí puede leer forma,",
    "densidad, ritmo y simetría, que es donde su criterio es fiable. Mirando el glifo",
    "real no puede — está comprobado que se equivoca.",
    "Por defecto se usa el del rol; aquí solo van las excepciones que aportan forma."
  ],
  "croquis_por_rol": {
    "anc": "x", "fil": "~", "trz": "-", "cor": "[", "par": "*", "sig": ".", "esp": "_"
  },
