  ],

  "_espaciadores": [
    "Anchos sin tinta, con su comportamiento frente al recorte MEDIDO, no supuesto.",
    "Discord e Instagram recortan según la propiedad Unicode White_Space, no según",
    "'parece vacío'. Por eso ㅤ y ⠀ sobreviven y el NBSP no, aunque los tres se vean",
    "igual. ⠀ (U+2800) es el más seguro: no es White_Space, no es Default_Ignorable,",
    "y su NFKC no cambia."
  ],
  "espaciadores": {
    "0020": { "ancho": 1, "preferido": true,  "nota": "espacio normal; se recorta en los extremos de línea" },
    "2800": { "ancho": 1, "preferido": true,  "nota": "el más seguro: sobrevive al trim, NFKC estable, no ignorable" },
    "3164": { "ancho": 2, "preferido": false, "nota": "sobrevive al trim pero es Default_Ignorable y pliega a U+1160 (W107)" },
    "00A0": { "ancho": 1, "preferido": false, "nota": "ES White_Space: Discord lo recorta y en nombres de canal se vuelve guion" },
    "2003": { "ancho": 2, "preferido": false, "nota": "ES White_Space: se recorta" },
    "3000": { "ancho": 2, "preferido": false, "nota": "ES White_Space: se recorta" }
  },

